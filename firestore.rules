rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        (request.auth.token.keys().hasAny(['superAdmin']) && request.auth.token.superAdmin == true)
        || request.auth.token.role == 'Admin_c'
        || request.auth.token.profile == 'Admin_c'
      );
    }

    function isBusinessOwner() {
      return signedIn() && request.auth.token.role == 'BusinessOwner_c';
    }

    function ownsBusiness(businessId) {
      return signedIn()
        && businessId is string
        && exists(/databases/$(database)/documents/businesses/$(businessId))
        && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid;
    }

    function managesBranch(branchId) {
      return signedIn()
        && request.auth.token.role == 'BranchManager_c'
        && branchId is string
        && exists(/databases/$(database)/documents/branches/$(branchId))
        && get(/databases/$(database)/documents/branches/$(branchId)).data.manager_c is list
        && get(/databases/$(database)/documents/branches/$(branchId)).data.manager_c.hasAny([
          { User: request.auth.uid }
        ]);
    }

    function ownerEditableFields() {
      return [
        'Name', 'category_c', 'subcategory_c', 'business_type_c',
        'owner_name_c', 'phone_c', 'whatsapp_c', 'email_c',
        'district_c', 'city_c', 'area_c', 'pincode_c', 'address_c',
        'description_c', 'map_url_c', 'latitude_c', 'longitude_c',
        'website_c', 'facebook_c', 'instagram_c', 'gstin_c', 'hours_c',
        'holiday_info_c', 'seo_title_c', 'meta_description_c',
        'slug_c', 'logo_c', 'cover_c', 'photos_c', 'ModifiedOn'
      ];
    }

    function validOwnerBusinessCreate() {
      return isBusinessOwner()
        && request.resource.data.keys().hasOnly([
          'Name', 'category_c', 'subcategory_c', 'business_type_c',
          'owner_name_c', 'phone_c', 'whatsapp_c',
          'district_c', 'city_c', 'area_c', 'pincode_c', 'address_c',
          'description_c', 'map_url_c', 'latitude_c', 'longitude_c',
          'facebook_c', 'instagram_c', 'gstin_c', 'hours_c',
          'holiday_info_c', 'seo_title_c', 'meta_description_c',
          'logo_c', 'slug_c',
          'ownerUid', 'ownerEmail', 'status_c', 'listing_type_c',
          'is_premium_c', 'is_verified_c', 'rating_c', 'reviews_count_c',
          'featured_order_c', 'CreatedOn', 'ModifiedOn'
        ])
        && request.resource.data.keys().hasAll([
          'Name', 'category_c', 'district_c', 'address_c', 'phone_c',
          'ownerUid', 'status_c', 'listing_type_c', 'is_premium_c',
          'is_verified_c', 'rating_c', 'reviews_count_c'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status_c == 'Pending Approval'
        && request.resource.data.listing_type_c == 'Free'
        && request.resource.data.is_premium_c == false
        && request.resource.data.is_verified_c == false
        && request.resource.data.rating_c == 0
        && request.resource.data.reviews_count_c == 0
        && request.resource.data.featured_order_c == 99;
    }

    // Private source records: admins can moderate all records; owners can
    // read and edit only records explicitly linked to their Firebase UID.
    match /businesses/{businessId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if validOwnerBusinessCreate();
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(ownerEditableFields())
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['cover_c', 'photos_c'])
          || resource.data.is_premium_c == true
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'website_c', 'email_c'
          ])
          || resource.data.is_premium_c == true
        )
      );
      allow delete: if isAdmin();
    }

    // Public business documents are curated server-side mirrors. They never
    // contain owner UID/email, private verification data, or internal notes.
    match /business_public/{businessId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /categories/{categoryId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /categories_public/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /branches/{branchId} {
      allow get, list: if isAdmin() || ownsBusiness(resource.data.business_c) || managesBranch(branchId);
      allow create: if isAdmin() || (isBusinessOwner() && ownsBusiness(request.resource.data.business_c));
      allow update: if isAdmin() || (
        isBusinessOwner() && ownsBusiness(resource.data.business_c)
        && request.resource.data.business_c == resource.data.business_c
      ) || (
        managesBranch(branchId)
        && request.resource.data.business_c == resource.data.business_c
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'Name', 'address_c', 'district_c', 'city_c', 'phone_c', 'map_url_c', 'hours_c', 'photos_c', 'ModifiedOn'
        ])
      );
      allow delete: if isAdmin() || (isBusinessOwner() && ownsBusiness(resource.data.business_c));
    }

    match /branches_public/{branchId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /products_services/{itemId} {
      allow get, list: if isAdmin() || ownsBusiness(resource.data.business_c);
      allow create: if isAdmin() || (
        isBusinessOwner() && ownsBusiness(request.resource.data.business_c)
      );
      allow update: if isAdmin() || (
        isBusinessOwner()
        && ownsBusiness(resource.data.business_c)
        && request.resource.data.business_c == resource.data.business_c
      );
      allow delete: if isAdmin() || (
        isBusinessOwner() && ownsBusiness(resource.data.business_c)
      );
    }

    match /products_services_public/{itemId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /reviews/{reviewId} {
      allow get, list: if isAdmin() || ownsBusiness(resource.data.business_c);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isBusinessOwner() && ownsBusiness(resource.data.business_c)
        && request.resource.data.business_c == resource.data.business_c
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner_reply_c', 'report_status_c', 'ModifiedOn'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['report_status_c'])
          || request.resource.data.report_status_c in ['Reported', 'Under Review', 'Hidden'])
      );
    }

    match /reviews_public/{reviewId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /offers/{offerId} {
      allow get, list: if isAdmin() || ownsBusiness(resource.data.business_c);
      allow create: if isAdmin() || (
        isBusinessOwner()
        && ownsBusiness(request.resource.data.business_c)
        && request.resource.data.status_c == 'Pending'
      );
      allow update: if isAdmin() || (
        isBusinessOwner()
        && ownsBusiness(resource.data.business_c)
        && request.resource.data.business_c == resource.data.business_c
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'status_c', 'is_homepage_featured_c', 'Owner', 'ownerUid'
        ])
      );
      allow delete: if isAdmin() || (
        isBusinessOwner() && ownsBusiness(resource.data.business_c)
      );
    }

    match /offers_public/{offerId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /homepage_banners/{bannerId} {
      allow read, write: if isAdmin();
    }

    match /homepage_banners_public/{bannerId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /site_settings/{settingId} {
      allow read, write: if isAdmin();
    }

    match /site_settings_public/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /content_pages/{pageId} {
      allow read, write: if isAdmin();
    }

    match /content_pages_public/{pageId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /premium_plans/{planId} {
      allow read, write: if isAdmin();
    }

    match /premium_plans_public/{planId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /business_documents/{documentId} {
      allow get, list: if isAdmin() || ownsBusiness(resource.data.business_c);
      allow create: if isAdmin() || (isBusinessOwner() && ownsBusiness(request.resource.data.business_c) && request.resource.data.status_c == 'Pending');
      allow update, delete: if isAdmin();
    }

    match /business_analytics/{analyticsId} {
      allow get, list: if isAdmin() || ownsBusiness(resource.data.business_c);
      allow create, update, delete: if isAdmin();
    }

    match /branch_activity/{activityId} {
      allow get, list: if isAdmin() || ownsBusiness(resource.data.business_c) || managesBranch(resource.data.branch_c);
      allow create: if isAdmin() || (isBusinessOwner() && ownsBusiness(request.resource.data.business_c)) || managesBranch(request.resource.data.branch_c);
      allow update, delete: if isAdmin();
    }

    match /enquiries/{enquiryId} {
      allow get, list: if isAdmin() || ownsBusiness(resource.data.business_c) || managesBranch(resource.data.branch_c);
      allow create: if false;
      allow update: if isAdmin() || (
        ownsBusiness(resource.data.business_c)
        && request.resource.data.business_c == resource.data.business_c
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply_c', 'status_c', 'ModifiedOn'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status_c'])
          || request.resource.data.status_c in ['New', 'In Progress', 'Resolved'])
      ) || (
        managesBranch(resource.data.branch_c)
        && request.resource.data.business_c == resource.data.business_c
        && request.resource.data.branch_c == resource.data.branch_c
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply_c', 'status_c', 'ModifiedOn'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status_c'])
          || request.resource.data.status_c in ['New', 'In Progress', 'Resolved'])
      );
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid) || ownsBusiness(resource.data.business_c);
      allow create: if isAdmin() || (
        isBusinessOwner() && ownsBusiness(request.resource.data.business_c)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status_c == 'Pending'
        && request.resource.data.amount_c is number && request.resource.data.amount_c > 0
      );
      allow update, delete: if isAdmin();
    }

    match /advertisements/{adId} {
      allow get, list: if isAdmin() || ownsBusiness(resource.data.business_c);
      allow create: if isAdmin() || (isBusinessOwner() && ownsBusiness(request.resource.data.business_c) && request.resource.data.status_c == 'Pending');
      allow update: if isAdmin() || (
        isBusinessOwner() && ownsBusiness(resource.data.business_c)
        && request.resource.data.business_c == resource.data.business_c
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status_c', 'amount_c', 'ad_type_c'])
      );
      allow delete: if isAdmin();
    }

    match /coupons/{couponId} {
      allow get, list: if isAdmin() || ownsBusiness(resource.data.business_c);
      allow create: if isAdmin() || (isBusinessOwner() && ownsBusiness(request.resource.data.business_c) && request.resource.data.status_c == 'Pending');
      allow update: if isAdmin() || (
        isBusinessOwner() && ownsBusiness(resource.data.business_c)
        && request.resource.data.business_c == resource.data.business_c
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status_c', 'code_c', 'usage_limit_c'])
      );
      allow delete: if isAdmin();
    }

    match /coupons_public/{couponId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status_c', 'ModifiedOn'])
        && request.resource.data.status_c == 'Read'
      );
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /support_requests/{requestId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.status_c == 'New';
      allow update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read, write: if isAdmin();
    }

    match /privacy_requests/{requestId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.status_c == 'New';
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
